# Bí mật — không bao giờ đưa lên git
.env

__pycache__/
*.pyc

# Dữ liệu nguồn + chunk RAG: nặng (data/raw ~166M) hoặc chưa chốt nơi lưu trữ lâu dài.
# Chỉ đưa lên git phần CSV đã xử lý trong data/processed/ — bảng số nhỏ, không có ảnh/PDF scan.
data/*
!data/processed
data/processed/*
!data/processed/*.csv
# Bảng nối do người gán (danh mục Trường/Khoa, mã chứng chỉ, bảng cầu) — là nguồn, phải lên git
!data/processed/linking
data/processed/linking/*
!data/processed/linking/*.csv
