# Sao chép file này thành `.env` rồi điền giá trị. KHÔNG đưa file .env lên git / chia sẻ.

# Key OpenAI dùng cho embedding (text-embedding-3-large — xem PLAN - Embedding (v1) mục 6.3 vì đổi khỏi -small)
OPENAI_API_KEY=

# Qdrant chạy bằng docker-compose.yml trong dự án
QDRANT_URL=http://localhost:6333

# Tên collection gắn với dataset_version để nhúng lại không ghi đè bản cũ
QDRANT_COLLECTION=hust_rag_2026_1
EMBEDDING_MODEL=text-embedding-3-large

# PostgreSQL chay bang docker-compose.yml (service "postgres") — PLAN - Backend PostgreSQL (v1).
# Dung 127.0.0.1, KHONG dung "localhost": tren Windows localhost thu IPv6 (::1) truoc ma Postgres chi mo
# 127.0.0.1 -> moi lan ket noi treo cho het timeout (da gap 2026-10-06).
# POSTGRES_PORT: cong tren may; doi neu cong 5432 bi du an khac chiem (doi ca trong DATABASE_URL).
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hust:<POSTGRES_PASSWORD>@127.0.0.1:5432/hust
