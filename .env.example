# Sao chép file này thành `.env` rồi điền giá trị. KHÔNG đưa file .env lên git / chia sẻ.

# Key OpenAI dùng cho embedding (text-embedding-3-small, PRD mục 16)
OPENAI_API_KEY=

# Qdrant chạy bằng docker-compose.yml trong dự án
QDRANT_URL=http://localhost:6333

# Tên collection gắn với dataset_version để nhúng lại không ghi đè bản cũ
QDRANT_COLLECTION=hust_rag_2026_1
EMBEDDING_MODEL=text-embedding-3-small
